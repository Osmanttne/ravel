# Optional. Copy to .env in the repository root.
# Fixture mode is the credential-free default. Set false only to enable Gemini.
APP_ENV=development
RAVEL_FIXTURE_MODE=true
# Server-side only. Never commit or paste a real key into source/client code.
GEMINI_API_KEY=

# Choose an available text/image model supporting structured output in your account.
# Current official docs list gemini-3.8-flash; no model is selected automatically.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
# Photon Spectrum cloud agent. Server-side only; leave blank for the local fixture demo.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Agent -> the existing FastAPI backend. No public webhook is needed for the stream adapter.
RAVEL_API_BASE_URL=http://127.0.0.1:8001
# Development only: permit this local HTTP backend. Remote deployments require HTTPS.
RAVEL_ALLOW_LOCAL_HTTP=true
RAVEL_CHECK_TIMEOUT_SECONDS=45
# Tiger Data / community reporting is deferred. No database connection is needed.

