{
  "name": "Ravel",
  "options": {
    "minimumXcodeGenVersion": "2.42.0",
    "projectFormat": "xcode15_0",
    "deploymentTarget": { "iOS": "17.0" },
    "developmentLanguage": "en",
    "defaultConfig": "Debug"
  },
  "configFiles": {
    "Debug": "Configuration/Developer.xcconfig",
    "Release": "Configuration/Developer.xcconfig"
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "CODE_SIGN_STYLE": "Automatic",
      "MARKETING_VERSION": "0.3.0",
      "CURRENT_PROJECT_VERSION": "1",
      "GENERATE_INFOPLIST_FILE": "NO"
    },
    "configs": {
      "Debug": {
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) DEBUG"
      },
      "Release": { "RAVEL_API_BASE_URL": "" }
    }
  },
  "packages": { "RavelCore": { "path": "RavelCore" } },
  "fileGroups": ["README.md", "project.json", "generate-project.sh", "Configuration"],
  "targets": {
    "Ravel": {
      "type": "application",
      "platform": "iOS",
      "sources": ["Ravel", "SharedUI"],
      "settings": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.osmantaka.ravel",
        "INFOPLIST_FILE": "Configuration/App-Info.plist",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon"
      },
      "dependencies": [
        { "package": "RavelCore", "product": "RavelCore" },
        { "target": "RavelShareExtension", "embed": true }
      ]
    },
    "RavelShareExtension": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": ["RavelShareExtension", "SharedUI"],
      "settings": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.osmantaka.ravel.share",
        "INFOPLIST_FILE": "Configuration/Share-Info.plist",
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "SKIP_INSTALL": "YES"
      },
      "dependencies": [{ "package": "RavelCore", "product": "RavelCore" }]
    },
    "RavelTests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": ["RavelTests"],
      "settings": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.osmantaka.ravel.uitests",
        "GENERATE_INFOPLIST_FILE": "YES",
        "TEST_TARGET_NAME": "Ravel"
      },
      "dependencies": [{ "target": "Ravel" }]
    },
    "RavelShareTestHost": {
      "type": "application",
      "platform": "iOS",
      "sources": ["RavelShareTestHost"],
      "settings": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.osmantaka.ravel.sharetesthost",
        "INFOPLIST_FILE": "Configuration/RavelShareTestHost-Info.plist"
      }
    }
  },
  "schemes": {
    "Ravel": { "build": { "targets": { "Ravel": "all" } }, "run": { "config": "Debug" }, "test": { "config": "Debug", "targets": ["RavelTests"] }, "archive": { "config": "Release" } },
    "RavelShareTestHost": { "build": { "targets": { "RavelShareTestHost": "all" } }, "run": { "config": "Debug" } }
  }
}
